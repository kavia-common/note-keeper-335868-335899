# Path to SQLite DB file created by notes_database container.
# Example (from notes_database/db_connection.txt):
# SQLITE_DB=/home/kavia/workspace/code-generation/note-keeper-335868-335898/notes_database/myapp.db
SQLITE_DB=

# Optional: restrict CORS origins (comma-separated). If empty, backend allows all origins.
# Example:
# FRONTEND_ORIGINS=http://localhost:3000,https://your-deployed-frontend.example
FRONTEND_ORIGINS=

# Optional log level
LOG_LEVEL=INFO
